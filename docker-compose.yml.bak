# EasyRAG 完整 Docker Compose 配置
# 包含所有核心服务和可选服务
# 使用方式：docker-compose -f docker-compose.full.yml up -d

services:
  # ==================== 核心服务 ====================
  
  # -------------------- PostgreSQL + pgvector --------------------
  postgres:
    image: pgvector/pgvector:pg16
    container_name: easyrag-postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: ${PG_SUPER_PASSWORD:-easyrag2026}
      POSTGRES_DB: easyrag
      EASYRAG_USER: easyrag
      EASYRAG_PASSWORD: ${PG_EASYRAG_PASSWORD:-easyrag2026}
    ports:
      - "5432:5432"
    volumes:
      - /lilin/EasyRAG/postgres_data:/var/lib/postgresql/data
      - ./sqls/init-db.sql:/docker-entrypoint-initdb.d/init.sql:ro
    dns:
      - 8.8.8.8
      - 114.114.114.114
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    networks:
      - easyrag-net

  # -------------------- Redis --------------------
  redis:
    image: redis:7-alpine
    container_name: easyrag-redis
    restart: unless-stopped
    command: redis-server --requirepass ${REDIS_PASSWORD:-easyrag2026} --appendonly yes --bind 0.0.0.0
    ports:
      - "6379:6379"
    volumes:
      - /lilin/EasyRAG/redis_data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "-a", "${REDIS_PASSWORD:-easyrag2026}", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - easyrag-net

  # -------------------- MinIO --------------------
  minio:
    image: minio/minio:latest
    container_name: easyrag-minio
    restart: unless-stopped
    command: server /data --console-address ":9001"
    ports:
      - "9000:9000"
      - "9001:9001"
    environment:
      MINIO_ROOT_USER: ${MINIO_ROOT_USER:-easyrag}
      MINIO_ROOT_PASSWORD: ${MINIO_ROOT_PASSWORD:-easyrag2026}
      MINIO_BROWSER_REDIRECT_URL: http://192.168.137.13:9001
    volumes:
      - /lilin/EasyRAG/minio_data:/data
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:9000/minio/health/live"]
      interval: 30s
      timeout: 10s
      retries: 3
    networks:
      - easyrag-net

  # -------------------- MinIO 初始化（创建 EasyRAG buckets）--------------------
  minio-init:
    image: minio/mc:latest
    container_name: easyrag-minio-init
    depends_on:
      minio:
        condition: service_healthy
    entrypoint: >
      /bin/sh -c "
      mc alias set myminio http://minio:9000 easyrag easyrag2026;
      mc mb myminio/easyrag-documents --ignore-existing;
      mc mb myminio/easyrag-models --ignore-existing;
      mc mb myminio/easyrag-uploads --ignore-existing;
      mc policy set download myminio/easyrag-documents;
      mc policy set download myminio/easyrag-models;
      mc policy set download myminio/easyrag-uploads;
      echo 'EasyRAG buckets created successfully';
      "
    restart: "no"
    networks:
      - easyrag-net

  # ==================== Langfuse V3 (LLM 调用追踪) ====================
  
  # -------------------- ClickHouse（Langfuse 数据存储）--------------------
  clickhouse:
    image: clickhouse/clickhouse-server:latest
    container_name: easyrag-clickhouse
    restart: unless-stopped
    #user: "101:101"
    environment:
      CLICKHOUSE_USER: easyrag
      CLICKHOUSE_PASSWORD: ${CLICKHOUSE_PASSWORD:-easyrag2026}
    volumes:
      - /lilin/EasyRAG/clickhouse_data:/var/lib/clickhouse
      - /lilin/EasyRAG/clickhouse_logs:/var/log/clickhouse-server
    ports:
      - "8123:8123"
      - "9005:9000"
    healthcheck:
      test: ["CMD-SHELL", "wget --no-verbose --tries=1 --spider http://localhost:8123/ping || exit 1"]
      interval: 5s
      timeout: 5s
      retries: 10
    networks:
      - easyrag-net

  # -------------------- Langfuse MinIO 初始化 --------------------
  langfuse-minio-init:
    image: minio/mc:latest
    container_name: easyrag-langfuse-minio-init
    depends_on:
      minio:
        condition: service_healthy
    entrypoint: >
      /bin/sh -c "
      mc alias set myminio http://minio:9000 easyrag easyrag2026;
      mc mb myminio/langfuse-events --ignore-existing;
      mc policy set download myminio/langfuse-events;
      echo 'Langfuse bucket created successfully';
      "
    restart: "no"
    networks:
      - easyrag-net

  # -------------------- Langfuse Server --------------------
  langfuse-server:
    image: langfuse/langfuse:latest
    container_name: easyrag-langfuse-server
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
      clickhouse:
        condition: service_healthy
      minio:
        condition: service_healthy
      langfuse-minio-init:
        condition: service_completed_successfully
    ports:
      - "3030:3000"
    environment:
      # PostgreSQL
      DATABASE_URL: "postgresql://langfuse:easyrag2026@postgres:5432/langfuse"
      
      # ClickHouse
      CLICKHOUSE_MIGRATION_URL: "clickhouse://easyrag:easyrag2026@clickhouse:9005"
      CLICKHOUSE_URL: "http://clickhouse:8123"
      CLICKHOUSE_USER: "easyrag"
      CLICKHOUSE_PASSWORD: "easyrag2026"
      CLICKHOUSE_CLUSTER_ENABLED: "false"
      
      # S3 / MinIO
      LANGFUSE_S3_EVENT_UPLOAD_BUCKET: "langfuse-events"
      LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT: "http://minio:9000"
      LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID: "easyrag"
      LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY: "easyrag2026"
      LANGFUSE_S3_EVENT_UPLOAD_REGION: "us-east-1"
      LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE: "true"
      
      # Redis
      REDIS_HOST: "redis"
      REDIS_PORT: "6379"
      REDIS_AUTH: "easyrag2026"
      
      # Auth
      NEXTAUTH_URL: "http://192.168.137.13:3030"
      NEXTAUTH_SECRET: "${LANGFUSE_SECRET_KEY:-a7f3e91b4c0d2856f692e103b7a84d5c}"
      SALT: "${LANGFUSE_SALT:-mR8kPzWnQ3vXs7LjFpYc2tBhNgMdVaRi}"
      ENCRYPTION_KEY: "15869610ef94e97a1a12e98db2c89dcd29006855cff9be9954621cd4e119c345"
      
      # Feature flags
      LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES: "false"
      NEXT_PUBLIC_SIGN_UP_DISABLED: "true"
    networks:
      - easyrag-net

  # -------------------- Langfuse Worker --------------------
  langfuse-worker:
    image: langfuse/langfuse-worker:latest
    container_name: easyrag-langfuse-worker
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
      clickhouse:
        condition: service_healthy
      redis:
        condition: service_healthy
      minio:
        condition: service_healthy
    environment:
      # PostgreSQL
      DATABASE_URL: "postgresql://langfuse:easyrag2026@postgres:5432/langfuse"
      
      # ClickHouse
      CLICKHOUSE_MIGRATION_URL: "clickhouse://easyrag:easyrag2026@clickhouse:9005"
      CLICKHOUSE_URL: "http://clickhouse:8123"
      CLICKHOUSE_USER: "easyrag"
      CLICKHOUSE_PASSWORD: "easyrag2026"
      CLICKHOUSE_CLUSTER_ENABLED: "false"
      
      # S3 / MinIO
      LANGFUSE_S3_EVENT_UPLOAD_BUCKET: "langfuse-events"
      LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT: "http://minio:9000"
      LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID: "easyrag"
      LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY: "easyrag2026"
      LANGFUSE_S3_EVENT_UPLOAD_REGION: "us-east-1"
      LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE: "true"
      
      # Redis
      REDIS_HOST: "redis"
      REDIS_PORT: "6379"
      REDIS_AUTH: "easyrag2026"
      
      # 加密（与 langfuse-server 必须一致）
      SALT: "${LANGFUSE_SALT:-mR8kPzWnQ3vXs7LjFpYc2tBhNgMdVaRi}"
      ENCRYPTION_KEY: "15869610ef94e97a1a12e98db2c89dcd29006855cff9be9954621cd4e119c345"
      
      # 其他
      NEXTAUTH_URL: "http://192.168.137.13:3030"
      LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES: "false"
    networks:
      - easyrag-net

  # ==================== Prometheus + Grafana (监控系统) ====================
  
  # -------------------- Prometheus --------------------
  prometheus:
    image: prom/prometheus:latest
    container_name: easyrag-prometheus
    restart: unless-stopped
    ports:
      - "9090:9090"
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - /lilin/EasyRAG/prometheus_data:/prometheus:z
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.path=/prometheus'
      - '--web.console.libraries=/etc/prometheus/console_libraries'
      - '--web.console.templates=/etc/prometheus/consoles'
      - '--storage.tsdb.retention.time=15d'
      - '--web.enable-lifecycle'
    healthcheck:
      test: ["CMD", "wget", "-q", "--spider", "http://localhost:9090/-/healthy"]
      interval: 30s
      timeout: 10s
      retries: 3
    networks:
      - easyrag-net

  # -------------------- Grafana --------------------
  grafana:
    image: grafana/grafana:latest
    container_name: easyrag-grafana
    restart: unless-stopped
    ports:
      - "3001:3000"
    environment:
      GF_SECURITY_ADMIN_USER: ${GRAFANA_ADMIN_USER:-admin}
      GF_SECURITY_ADMIN_PASSWORD: ${GRAFANA_ADMIN_PASSWORD:-easyrag2026}
      GF_INSTALL_PLUGINS: redis-datasource,grafana-clock-panel
      GF_USERS_ALLOW_SIGN_UP: "false"
    volumes:
      - /lilin/EasyRAG/grafana_data:/var/lib/grafana
    depends_on:
      - prometheus
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:3000/api/health"]
      interval: 30s
      timeout: 10s
      retries: 3
    networks:
      - easyrag-net

  # ==================== OpenSandbox (代码执行沙箱) ====================
  
  # -------------------- OpenSandbox Server --------------------
  opensandbox-server:
    image: opensandbox/server:latest
    container_name: easyrag-opensandbox-server
    restart: unless-stopped
    ports:
      - "8090:8090"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - /lilin/EasyRAG/opensandbox-config.toml:/etc/opensandbox/config.toml:ro
    environment:
      SANDBOX_CONFIG_PATH: /etc/opensandbox/config.toml
    networks:
      - easyrag-net

  # -------------------- OpenSandbox Client --------------------
  opensandbox-client:
    image: python:3.11-slim
    container_name: easyrag-opensandbox-client
    restart: unless-stopped
    command: >
      sh -c "pip install opensandbox && tail -f /dev/null"
    environment:
      OPEN_SANDBOX_DOMAIN: opensandbox-server:8090
      OPEN_SANDBOX_API_KEY: ${OPENSANDBOX_API_KEY:-easyrag2026}
    depends_on:
      - opensandbox-server
    networks:
      - easyrag-net

  # ==================== 应用服务（开发后启用）====================
  
  # -------------------- Backend (FastAPI) --------------------
  # 后端服务暂不启动，等待开发完成后启用
  # backend:
  #   build:
  #     context: ./backend
  #     dockerfile: Dockerfile
  #   container_name: easyrag-backend
  #   restart: unless-stopped
  #   ports:
  #     - "8000:8000"
  #   environment:
  #     DATABASE_URL: postgresql+asyncpg://easyrag:easyrag2026@postgres:5432/easyrag
  #     REDIS_URL: redis://redis:6379?password=easyrag2026
  #     MINIO_ENDPOINT: minio:9000
  #     MINIO_ACCESS_KEY: easyrag
  #     MINIO_SECRET_KEY: easyrag2026
  #     JWT_SECRET_KEY: ${JWT_SECRET_KEY:-your-secret-key-change-in-production}
  #     OPENAI_API_KEY: ${OPENAI_API_KEY}
  #     LANGFUSE_PUBLIC_KEY: ${LANGFUSE_PUBLIC_KEY}
  #     LANGFUSE_SECRET_KEY: ${LANGFUSE_SECRET_KEY}
  #     LANGFUSE_ENABLED: ${LANGFUSE_ENABLED:-false}
  #   depends_on:
  #     postgres:
  #       condition: service_healthy
  #     redis:
  #       condition: service_healthy
  #     minio:
  #       condition: service_healthy
  #     minio-init:
  #       condition: service_completed_successfully
  #     langfuse-server:
  #       condition: service_started
  #   volumes:
  #     - ./backend:/app
  #   networks:
  #     - easyrag-net

  # -------------------- Frontend (Vue 3) --------------------
  # 前端服务暂不启动，等待开发完成后启用
  # frontend:
  #   build:
  #     context: ./frontend
  #     dockerfile: Dockerfile
  #   container_name: easyrag-frontend
  #   restart: unless-stopped
  #   ports:
  #     - "3000:3000"
  #   depends_on:
  #     - backend
  #   networks:
  #     - easyrag-net

# ==================== 自定义网络 ====================
networks:
  easyrag-net:
    driver: bridge
    name: easyrag-network

# ==================== 数据卷（可选定义）====================
# volumes:
#   postgres_data:
#     driver: local
#   redis_data:
#     driver: local
#   minio_data:
#     driver: local
#   clickhouse_data:
#     driver: local
#   clickhouse_logs:
#     driver: local
#   prometheus_data:
#     driver: local
#   grafana_data:
#     driver: local