.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ========== Editor / IDE ==========
.vs/
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# ========== Environment & Secrets ==========
.env
.env.local
.env.*.local
*.env.local
appsettings.Development.json
appsettings.Local.json

# ========== Logs ==========
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ========== Node.js (Frontend) ==========
**/node_modules/
npm-debug.log*
yarn-debug.log*
.npm
.yarn

# ========== Build Outputs ==========
dist/
dist-ssr/
*.local

# ========== .NET (Backend) ==========
**/bin/
**/obj/
*.dll
*.exe
*.pdb
*.cache

# ========== Uploads & Temporary ==========
uploads/
*.tmp
*.temp

# ========== Database ==========
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

