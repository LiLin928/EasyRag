ENV=development
SECRET_KEY=change-me-to-a-random-string
API_PREFIX=/api/v2
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://easyrag:easyrag2026@192.168.137.13:5432/easyrag_v2

# JWT
JWT_ACCESS_EXPIRE=7200
JWT_REFRESH_EXPIRE=604800

# Admin
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=admin123

# CORS
CORS_ORIGINS=http://localhost:3000

# Tracing（可选：langsmith / langfuse / none）
TRACING_PROVIDER=none
# LANGSMITH_API_KEY=your-api-key
# LANGSMITH_PROJECT=easyrag
# LANGFUSE_PUBLIC_KEY=your-public-key
# LANGFUSE_SECRET_KEY=your-secret-key
LANGFUSE_HOST=http://192.168.137.13:3030

# 默认模型配置（可选，可在 settings 中配置）
# LLM_DEFAULT_BASE_URL=https://api.openai.com/v1
# LLM_DEFAULT_API_KEY=your-api-key
# LLM_QA_MODEL=gpt-4
# LLM_FAST_MODEL=gpt-3.5-turbo
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1024
# RERANK_MODEL=your-rerank-model

# 对象存储
STORAGE_TYPE=minio
MINIO_ENDPOINT=192.168.137.13:9000
MINIO_ACCESS_KEY=easyrag
MINIO_SECRET_KEY=easyrag2026
MINIO_BUCKET=easyrag
MINIO_SECURE=false
MINIO_PUBLIC_URL=http://192.168.137.13:9000

# Prometheus 监控配置
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
PROMETHEUS_SCRAPE_INTERVAL=15

# 指标标签配置
METRICS_NAMESPACE=easyrag
METRICS_ENVIRONMENT=development